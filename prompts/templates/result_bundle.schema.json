{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MRS Result Bundle",
  "type": "object",
  "required": ["results"],
  "properties": {
    "problem_slug": { "type": "string" },
    "campaign_id": { "type": "string" },
    "results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["content"],
        "properties": {
          "source": { "type": "string" },
          "role": {
            "type": "string",
            "enum": [
              "explorer",
              "historian",
              "prover",
              "critic",
              "formalizer",
              "synthesizer",
              "unknown"
            ]
          },
          "title": { "type": "string" },
          "content": { "type": "string", "minLength": 1 },
          "claims": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "type": { "type": "string" },
                "statement": { "type": "string" },
                "status": { "type": "string" }
              }
            }
          },
          "score": { "type": "number", "minimum": 1, "maximum": 5 }
        }
      }
    },
    "synthesis_focus": { "type": "string" }
  }
}
