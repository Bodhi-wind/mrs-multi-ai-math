# MRS LLM (optional). Without keys, roles use offline research templates.
# Never commit real keys. Compatible with OpenAI and many OpenAI-compatible gateways.

MRS_LLM_API_KEY=
MRS_LLM_BASE_URL=https://api.openai.com/v1
MRS_LLM_MODEL=gpt-4o-mini
MRS_LLM_TIMEOUT_MS=120000

# Set true to force template engine even if key present
MRS_LLM_FORCE_TEMPLATE=false
